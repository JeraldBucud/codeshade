{
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "esModuleInterop": true,
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "vscode", "vitest/globals"]
  },
  "include": ["src", "tests", "eslint.config.mjs", "esbuild.mjs", "vitest.config.ts"]
}
